# Konfigurasi Database Turso (libSQL)
TURSO_DATABASE_URL="libsql://your-database-name.turso.io"
TURSO_AUTH_TOKEN="your-turso-auth-token"

# Kunci rahasia untuk menandatangani cookie sesi login (isi dengan string acak panjang)
AUTH_SECRET="your-random-secret-key"

# Kredensial awal akun Admin untuk seeder (npx tsx src/db/seed.ts)
SEED_ADMIN_NAME="Pengurus RT 05 (Admin)"
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="change-this-admin-password"
